{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ADB Studio",
  "version": "0.1.0",
  "identifier": "com.wadb.adb-studio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ADB Studio",
        "width": 1120,
        "height": 720,
        "minWidth": 880,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage", "deb"],
    "category": "DeveloperTool",
    "shortDescription": "Ferramenta Linux leve para ADB, scrcpy e fastboot",
    "longDescription": "ADB Studio é uma ferramenta gráfica, leve e local-first para trabalhar com Android Debug Bridge, scrcpy e fastboot: gerenciamento de dispositivos, shell, screenshots, espelhamento de tela, arquivos, logs e diagnóstico.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png"
    ]
  }
}
